# Caddy configuration for IEEE SMC 2027 CDN & MinIO Proxy
# Automatic SSL (Let's Encrypt / ZeroSSL) for cdn.ieee-smc2027.org

cdn.ieee-smc2027.org {
    # Reverse proxy to MinIO Object Storage (port 9000)
    reverse_proxy minio:9000 {
        header_up Host {upstream_hostport}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }

    # Cache headers for static CDN assets
    @static path /ieee-smc-2027/public/* /public/*
    header @static Cache-Control "public, max-age=31536000, immutable"
}
