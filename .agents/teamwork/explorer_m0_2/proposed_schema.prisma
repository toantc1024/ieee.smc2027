datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  USER
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model User {
  id              String         @id @default(uuid())
  email           String         @unique
  name            String
  avatar          String?
  role            Role           @default(USER)
  provider        String         @default("google")
  passwordHash    String?        @map("password_hash")
  profileData     Json           @default("{}") @map("profile_data")
  status          String         @default("ACTIVE")
  lastLoginAt     DateTime?      @map("last_login_at")
  lastLoginIp     String?        @map("last_login_ip")
  lastLoginDevice String?        @map("last_login_device")
  sessionVersion  Int            @default(1) @map("session_version")
  posts           Post[]
  registrations   Registration[]
  mediaFiles      MediaFile[]
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  @@index([status])
  @@map("users")
}

model Post {
  id          String     @id @default(uuid())
  slug        String     @unique
  title       String
  summary     String?
  content     String     @db.Text
  coverImage  String?    @map("cover_image")
  status      PostStatus @default(DRAFT)
  category    String     @default("General")
  views       Int        @default(0)
  authorId    String?    @map("author_id")
  author      User?      @relation(fields: [authorId], references: [id], onDelete: SetNull)
  publishedAt DateTime?  @map("published_at")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  @@index([status])
  @@index([slug])
  @@map("posts")
}

model Page {
  id              String           @id @default(uuid())
  slug            String           @unique
  title           String
  blocks          Json             @default("[]")
  content         Json?
  parentId        String?          @map("parent_id")
  parent          Page?            @relation("PageHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children        Page[]           @relation("PageHierarchy")
  orderIndex      Int              @default(0) @map("order_index")
  version         Int              @default(1)
  isPublished     Boolean          @default(true) @map("is_published")
  metaTitle       String?          @map("meta_title")
  metaDescription String?          @map("meta_description")
  templateId      String?          @map("template_id")
  template        WebsiteTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  histories       PageHistory[]
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  @@index([parentId])
  @@index([orderIndex])
  @@index([templateId])
  @@map("website_pages")
}

model PageHistory {
  id            String   @id @default(uuid())
  pageId        String   @map("page_id")
  page          Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  version       Int
  content       Json?
  changeSummary String?  @map("change_summary")
  createdAt     DateTime @default(now()) @map("created_at")

  @@unique([pageId, version])
  @@index([pageId])
  @@map("website_page_histories")
}

model WebsiteTemplate {
  id           String   @id @default(uuid())
  name         String
  description  String?
  category     String   @default("General")
  thumbnail    String?
  content      Json?
  headerConfig Json?    @map("header_config")
  footerConfig Json?    @map("footer_config")
  pages        Page[]
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([category])
  @@map("website_templates")
}

model Setting {
  key       String   @id
  data      Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("website_settings")
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum ParticipantType {
  AUTHOR
  STUDENT
  IEEE_MEMBER
  REGULAR
}

model Registration {
  id                 String          @id @default(uuid())
  registrationCode   String          @unique @map("registration_code")
  userId             String?         @map("user_id")
  user               User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  fullName           String          @map("full_name")
  email              String
  phone              String?
  affiliation        String
  country            String
  participantType    ParticipantType @default(REGULAR) @map("participant_type")
  paperId            String?         @map("paper_id")
  paperTitle         String?         @map("paper_title")
  passportNumber     String?         @map("passport_number")
  needsVisaSupport   Boolean         @default(false) @map("needs_visa_support")
  dietaryRequirement String?         @default("None") @map("dietary_requirement")
  travelNotes        String?         @map("travel_notes")
  avatarUrl          String?         @map("avatar_url")
  formData           Json            @default("{}") @map("form_data")
  feeAmount          Int             @map("fee_amount")
  currency           String          @default("VND")
  paymentStatus      PaymentStatus   @default(PENDING) @map("payment_status")
  paymentMethod      String?         @default("PAYOO_VIETQR") @map("payment_method")
  transactionRef     String?         @map("transaction_ref")
  paidAt             DateTime?       @map("paid_at")
  checkInStatus      Boolean         @default(false) @map("check_in_status")
  checkedInAt        DateTime?       @map("checked_in_at")
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  @@index([registrationCode])
  @@index([email])
  @@index([userId])
  @@index([paymentStatus])
  @@map("conference_registrations")
}

model MediaFile {
  id           String   @id @default(uuid())
  key          String   @unique
  filename     String
  originalName String   @map("original_name")
  mimeType     String   @map("mime_type")
  size         Int
  width        Int?
  height       Int?
  url          String
  proxyUrl     String   @map("proxy_url")
  blurDataURL  String?  @map("blur_data_url") @db.Text
  folder       String   @default("public/uploads")
  category     String   @default("IMAGE")
  uploadedById String?  @map("uploaded_by_id")
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([category])
  @@index([folder])
  @@map("media_files")
}

model EmailTemplate {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  milestone   String
  targetGroup String   @default("ALL") @map("target_group")
  subject     String
  preheader   String?
  htmlContent String   @map("html_content") @db.Text
  textContent String   @map("text_content") @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([milestone])
  @@map("email_templates")
}
