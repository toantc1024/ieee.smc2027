+// ============================================================
+// CLIENT IP & DEVICE EXTRACTION & LOGIN TRACKING
+// ============================================================
+
+export function extractClientInfo(request: Request | any): {
+  ip: string;
+  device: string;
+} {
+  const headers = request.headers;
+  let ip = (request as any).ip;
+
+  if (!ip) {
+    const forwarded = headers.get("x-forwarded-for");
+    if (forwarded) {
+      ip = forwarded.split(",")[0].trim();
+    }
+  }
+
+  if (!ip) {
+    ip =
+      headers.get("x-real-ip") ||
+      headers.get("cf-connecting-ip") ||
+      headers.get("true-client-ip") ||
+      headers.get("fastly-client-ip") ||
+      headers.get("x-client-ip") ||
+      null;
+  }
+
+  if (!ip || ip === "::1" || ip === "::ffff:127.0.0.1") {
+    ip = "127.0.0.1";
+  }
+
+  const rawUserAgent = headers.get("user-agent") || "Unknown Device";
+  const device = rawUserAgent.length > 255 ? rawUserAgent.slice(0, 255) : rawUserAgent;
+
+  return { ip, device };
+}
+
+export async function recordLogin(
+  userId: string,
+  ip?: string | null,
+  device?: string | null
+): Promise<void> {
+  try {
+    await prisma.user.update({
+      where: { id: userId },
+      data: {
+        lastLoginAt: new Date(),
+        ...(ip ? { lastLoginIp: ip } : {}),
+        ...(device ? { lastLoginDevice: device } : {}),
+      },
+    });
+  } catch (error) {
+    console.warn(`[auth] Failed to record login tracking for ${userId}:`, error);
+  }
+}
