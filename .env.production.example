# ==============================================================================
# IEEE SMC 2027 - PRODUCTION ENVIRONMENT (.env.production.example)
# ==============================================================================
# Usage: Production Server (HCMUTE On-Premise Server or Cloud VPS)
# Domain: https://ieee-smc2027.org
# ==============================================================================

# [1] ENVIRONMENT & APPLICATION RUNTIME
NODE_ENV="production"
APP_ENV="production"
NEXT_PUBLIC_APP_URL="https://ieee-smc2027.org"

# [2] DATABASE (PRISMA ORM + PRODUCTION POSTGRESQL)
POSTGRES_PASSWORD="CHANGE_ME_PROD_POSTGRES_PASSWORD"
DOCKER_DATABASE_URL="postgresql://postgres:${POSTGRES_PASSWORD}@postgres:5432/ieee_smc_2027?schema=public"
DATABASE_URL="postgresql://postgres:${POSTGRES_PASSWORD}@postgres:5432/ieee_smc_2027?schema=public"

# [3] AUTHENTICATION & SECURITY
JWT_SECRET="CHANGE_ME_TO_64_CHAR_CRYPTOGRAPHIC_RANDOM_SECRET_IN_PRODUCTION"
SESSION_COOKIE_NAME="admin_session"
GOOGLE_CLIENT_ID="CHANGE_ME_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="CHANGE_ME_PROD_GOOGLE_CLIENT_SECRET"

# [4] FILE STORAGE (MINIO PRODUCTION CLUSTER / CONTAINER)
MINIO_ENDPOINT="minio"
MINIO_PORT="9000"
MINIO_USE_SSL="false"
MINIO_ACCESS_KEY="CHANGE_ME_PROD_MINIO_ACCESS_KEY"
MINIO_SECRET_KEY="CHANGE_ME_PROD_MINIO_SECRET_KEY"
MINIO_BUCKET="ieee-smc-2027"
MINIO_REGION="ap-southeast-1"
MINIO_PUBLIC_URL="https://cdn.ieee-smc2027.org/ieee-smc-2027"

# [5] EMAIL & TRANSACTIONAL NOTIFICATION SERVICE
EMAIL_DEV_MODE="false"
EMAIL_SERVER_HOST="smtp.mailgun.org"
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER="postmaster@mg.ieee-smc2027.org"
EMAIL_SERVER_PASSWORD="CHANGE_ME_PROD_SMTP_PASSWORD"
EMAIL_FROM="IEEE SMC 2027 <no-reply@ieee-smc2027.org>"

# [6] PAYMENT & BANK RECONCILIATION
VIETQR_BANK_ID="VCB"
VIETQR_BANK_NAME="Vietcombank - Chi nhanh Thu Duc, TP. Ho Chi Minh"
VIETQR_ACCOUNT_NO="0381000385642"
VIETQR_ACCOUNT_NAME="TRUONG DH SU PHAM KY THUAT TPHCM"
VIETQR_SWIFT_BIC="BFTVVNVX"
PAYMENT_WEBHOOK_SECRET="CHANGE_ME_PROD_WEBHOOK_SECRET"
CARD_GATEWAY_PROVIDER="STRIPE"
CARD_GATEWAY_PUBLIC_KEY="pk_live_CHANGE_ME"
CARD_GATEWAY_SECRET_KEY="sk_live_CHANGE_ME"
CARD_GATEWAY_WEBHOOK_SECRET="whsec_CHANGE_ME"
