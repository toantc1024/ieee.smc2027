# ============================================================
# IEEE SMC 2027 - PRODUCTION ENVIRONMENT CONFIGURATION
# ============================================================
# Deployment: Production Server / Cloud (AWS, Docker, Vercel)
# Domain: https://ieee-smc2027.org

NODE_ENV="production"

# Database (Neon Production Connection Pooler)
DATABASE_URL="postgresql://neondb_owner:YOUR_PROD_PASSWORD@ep-noisy-fog-b3e9u0a7-pooler.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Application Base URL (Strict HTTPS)
NEXT_PUBLIC_APP_URL="https://ieee-smc2027.org"

# Cryptographically Secure JWT Secret (64+ chars)
JWT_SECRET="CHANGE_ME_TO_A_VERY_LONG_CRYPTOGRAPHICALLY_SECURE_RANDOM_SECRET_KEY_PROD"

# Google OAuth 2.0 (Production Client)
# Client ID: 47206661641-qdujeivtbc3oskquv61123duc4uad0nt.apps.googleusercontent.com
# Authorized Redirect URI: https://ieee-smc2027.org/api/auth/callback/google
# Authorized JS Origins: https://ieee-smc2027.org
GOOGLE_CLIENT_ID="47206661641-qdujeivtbc3oskquv61123duc4uad0nt.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="PROD_GOOGLE_CLIENT_SECRET"

# WeChat Open Platform (Official Enterprise Account)
# Authorized Redirect URI: https://ieee-smc2027.org/api/auth/callback/wechat
WECHAT_APP_ID="wx_production_verified_appid"
WECHAT_APP_SECRET="wx_production_verified_secret"
WECHAT_DEV_MODE="false"

# Production Transactional Email Service (SMTP or Resend)
EMAIL_DEV_MODE="false"
EMAIL_SERVER_HOST="smtp.mailgun.org"
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER="postmaster@mg.ieee-smc2027.org"
EMAIL_SERVER_PASSWORD="PROD_SMTP_PASSWORD"
EMAIL_FROM="IEEE SMC 2027 <contact@ieee-smc2027.org>"

# Super Admin Bootstrap
ADMIN_INITIAL_EMAIL="admin@hcmute.edu.vn"
ADMIN_INITIAL_PASSWORD="CHANGE_ME_IN_PRODUCTION"
