# ==============================================================================
# IEEE SMC 2027 - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Copy to .env for local development or configure in Production deployment.
# Do NOT commit real secrets in .env to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# [1] ENVIRONMENT & APPLICATION RUNTIME
# ------------------------------------------------------------------------------
NODE_ENV="development"
APP_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# [2] DATABASE (PRISMA ORM + POSTGRESQL)
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ieee_smc_2027?schema=public"

# ------------------------------------------------------------------------------
# [3] AUTHENTICATION & SECURITY (NO WECHAT)
# ------------------------------------------------------------------------------
JWT_SECRET="ieee_smc_2027_ultra_secure_jwt_secret_key_change_in_production_92837482"
SESSION_COOKIE_NAME="admin_session"

# Super Admin Bootstrap Account
ADMIN_INITIAL_EMAIL="admin@hcmute.edu.vn"
ADMIN_INITIAL_PASSWORD="Admin@Smc2027Secure!"

# Google OAuth 2.0 (Admin Portal)
GOOGLE_CLIENT_ID="47206661641-iutuq764g4j35bfqe6nq4lsm6tuod750.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret_here"

# ------------------------------------------------------------------------------
# [4] FILE STORAGE (MINIO S3-COMPATIBLE OBJECT STORAGE)
# ------------------------------------------------------------------------------
MINIO_ENDPOINT="localhost"
MINIO_PORT="9000"
MINIO_USE_SSL="false"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin123"
MINIO_BUCKET="ieee-smc-2027"
MINIO_REGION="ap-southeast-1"
MINIO_PUBLIC_URL="http://localhost:9000/ieee-smc-2027"

# ------------------------------------------------------------------------------
# [5] EMAIL & TRANSACTIONAL NOTIFICATION SERVICE
# ------------------------------------------------------------------------------
EMAIL_DEV_MODE="true"
EMAIL_SERVER_HOST="smtp.gmail.com"
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER="admin@ieee-smc2027.org"
EMAIL_SERVER_PASSWORD="your_app_specific_password"
EMAIL_FROM="IEEE SMC 2027 <no-reply@ieee-smc2027.org>"

# ------------------------------------------------------------------------------
# [6] PAYMENT & BANK RECONCILIATION (VIETQR & INTERNATIONAL CARD)
# ------------------------------------------------------------------------------
VIETQR_BANK_ID="VCB"
VIETQR_BANK_NAME="Vietcombank - Chi nhanh Thu Duc, TP. Ho Chi Minh"
VIETQR_ACCOUNT_NO="0381000385642"
VIETQR_ACCOUNT_NAME="TRUONG DH SU PHAM KY THUAT TPHCM"
VIETQR_SWIFT_BIC="BFTVVNVX"
PAYMENT_WEBHOOK_SECRET="dev_payment_webhook_secret_key"

# International Card Gateway (OnePay / Stripe)
CARD_GATEWAY_PROVIDER="STRIPE"
CARD_GATEWAY_PUBLIC_KEY=""
CARD_GATEWAY_SECRET_KEY=""
CARD_GATEWAY_WEBHOOK_SECRET=""
