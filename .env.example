# ============================================================
# IEEE SMC 2027 - ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================
# Copy this file to .env.local for local development,
# or configure in production deployment environment (Vercel, Docker, AWS).

# ------------------------------------------------------------
# 1. Database Configuration (PostgreSQL / Neon)
# ------------------------------------------------------------
DATABASE_URL="postgresql://username:password@ep-sample-pooler.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# ------------------------------------------------------------
# 2. Application & Session Settings
# ------------------------------------------------------------
# Local dev: http://localhost:3000 (or http://localhost:3002)
# Production: https://ieee-smc2027.org
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# HS256 JWT Secret Key (Generate with: openssl rand -base64 48)
JWT_SECRET="ieee_smc_2027_ultra_secure_jwt_secret_key_change_in_production_92837482"

# ------------------------------------------------------------
# 3. Google OAuth 2.0 Credentials
# ------------------------------------------------------------
# Google Cloud Console: https://console.cloud.google.com/apis/credentials
# Development Client ID: 47206661641-iutuq764g4j35bfqe6nq4lsm6tuod750.apps.googleusercontent.com
# Production Client ID:  47206661641-qdujeivtbc3oskquv61123duc4uad0nt.apps.googleusercontent.com
# Authorized Redirect URI (Dev):  http://localhost:3000/api/auth/callback/google
# Authorized Redirect URI (Prod): https://ieee-smc2027.org/api/auth/callback/google
GOOGLE_CLIENT_ID="47206661641-iutuq764g4j35bfqe6nq4lsm6tuod750.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret_here"

# ------------------------------------------------------------
# 4. WeChat Open Platform (微信开放平台 - 网站应用扫码登录)
# ------------------------------------------------------------
# WeChat Open Platform: https://open.weixin.qq.com
# Authorized Redirect URI (Dev):  http://localhost:3000/api/auth/callback/wechat
# Authorized Redirect URI (Prod): https://ieee-smc2027.org/api/auth/callback/wechat
WECHAT_APP_ID="wx_sample_appid_here"
WECHAT_APP_SECRET="wx_sample_app_secret_here"
# In local development without verified WeChat enterprise account, set to true to enable dev simulator
WECHAT_DEV_MODE="true"

# ------------------------------------------------------------
# 5. Email Service & OTP (One-Time Password) Authentication
# ------------------------------------------------------------
# In local development, EMAIL_DEV_MODE="true" will display OTP code in UI/console for instant testing
EMAIL_DEV_MODE="true"
EMAIL_SERVER_HOST="smtp.gmail.com"
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER="admin@ieee-smc2027.org"
EMAIL_SERVER_PASSWORD="your_app_specific_password"
EMAIL_FROM="IEEE SMC 2027 <no-reply@ieee-smc2027.org>"

# ------------------------------------------------------------
# 6. Admin Password Authentication Credentials
# ------------------------------------------------------------
# Super admin email whitelist
ADMIN_INITIAL_EMAIL="admin@hcmute.edu.vn"
# Default admin fallback password (can be changed in database)
ADMIN_INITIAL_PASSWORD="Admin@Smc2027Secure!"
